# Copy to .env.local (development) or set in your host's environment settings.
# NEVER commit real values. Every variable is read in src/server/config.ts (server) or is NEXT_PUBLIC_* (browser, public by design).

# ---- Environment -------------------------------------------------------------------------------
APP_ENV=staging                 # development | test | staging | production. Staging shows the Test banner and blocks search engines.
# TEST_BANNER=1                 # force the "Test site" banner
# NOINDEX=1                     # force "noindex" headers and a disallow-all robots.txt

# ---- Database (any PostgreSQL 15+; Supabase: use the pooler connection string, port 6543) --------
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DB_POOL_MAX=3
# PGLITE_DIR=.data/pglite       # development only: embedded Postgres when DATABASE_URL is empty

# ---- Secrets (generate with: openssl rand -base64 48) --------------------------------------------
SIGNING_SECRET=                 # signs short-lived photo links, hashes numbers and addresses
CRON_SECRET=                    # protects POST/GET /api/jobs/purge (Vercel Cron sends it automatically)

# ---- Staff sign-in (Supabase Auth, mandatory authenticator-app code) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # the publishable (anon) key; safe in the browser
# AUTH_PROVIDER=supabase        # "dev" is refused in staging and production
# NEXT_PUBLIC_AUTH_MODE=dev     # development/test only: shows the development sign-in buttons

# ---- AI provider (swap provider or model without code changes) -----------------------------------
AI_PROVIDER=openai-compatible   # anthropic | openai-compatible | mock (mock is refused in staging/production)
AI_MODEL=anthropic/claude-sonnet-4.5
# AI_API_KEY=                   # for AI_AUTH=bearer
# AI_BASE_URL=                  # default https://ai-gateway.vercel.sh/v1 (openai-compatible) or https://api.anthropic.com (anthropic)
# AI_AUTH=vercel-oidc           # bearer | vercel-oidc (Vercel AI Gateway with no key to manage)
# AI_PASSES=2                   # independent passes; disagreement lowers a point to "Not sure"
# AI_TIMEOUT_MS=50000

# ---- Photo storage -------------------------------------------------------------------------------
# Default: private table in the database (no public URL exists). For an S3-compatible bucket set all four:
# S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_BUCKET=case-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Bot protection ------------------------------------------------------------------------------
# BOTCHECK=pow                  # pow (self-hosted proof of work, default) | turnstile | off
# BOTCHECK_DIFFICULTY=14
# TURNSTILE_SECRET_KEY=         # with BOTCHECK=turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Business settings ---------------------------------------------------------------------------
WHATSAPP_NUMBER=                # cosmetologist's WhatsApp Business number, with country code. Also editable in the console.
RETENTION_UNBOOKED_HOURS=72     # proposed rule; staging uses 24
RETENTION_CLOSED_DAYS=90        # booked cases: kept until closure plus this many days

# ---- Contact details shown on the Contact page (public) -------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_LOCATION=
# NEXT_PUBLIC_CONTACT_WHATSAPP=
# NEXT_PUBLIC_SITE_URL=https://example.com   # for the sitemap once indexing is allowed
