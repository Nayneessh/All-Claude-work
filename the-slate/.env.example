# Public, browser-visible values only (safe to expose: protected by Row Level Security).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: IANA timezone used for "today", reminders and the 8 AM report (default Asia/Kolkata)
VITE_TIMEZONE=Asia/Kolkata
# NEVER put service-role keys, database passwords or AI keys here. They live only in Supabase/GitHub secrets.
