{
  "name": "the-slate",
  "private": true,
  "version": "1.0.0",
  "description": "THE SLATE — executive recruitment management & personal productivity command centre",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4175 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:db": "vitest run supabase/tests",
    "test:e2e": "playwright test",
    "health": "node scripts/health/check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
